pico-8 cartridge // http://www.pico-8.com
version 42
__lua__
-- rainbow unicorn
-- hop the rainbow blocks, grab
-- the coins, zap the robber with
-- magic stars, and hide in the
-- fort when he gets close!

function _init()
 grav=0.25
 layouts={
  {{0,120,128},{30,98,36},{82,98,40},{36,76,56},
   {0,54,36},{92,54,36},{40,32,48}},
  {{0,120,128},{34,100,26},{70,98,26},{104,100,24},
   {20,78,36},{72,78,36},{0,56,28},{50,56,28},
   {100,56,28},{30,34,68}},
  {{0,120,50},{78,120,50},{30,98,24},{74,98,24},
   {0,78,40},{88,78,40},{44,60,40},{8,40,32},
   {88,40,32},{44,22,40}},
 }
 fort={x=1,y=103,w=24,h=17}
 clouds={}
 for i=1,4 do add(clouds,{x=rnd(128),y=12+rnd(80),s=0.1+rnd(0.2)}) end
 state="title"
end

function new_game()
 score=0
 lives=3
 level=1
 start_level()
end

function start_level()
 plats={}
 for l in all(layouts[(level-1)%#layouts+1]) do
  add(plats,{x=l[1],y=l[2],w=l[3]})
 end
 pl={w=15,h=16,face=1,cool=0,hurt=0}
 home()
 stars={}
 coins={}
 for i=1,4+level*2 do add_coin() end
 robbers={}
 for i=1,min(4,1+flr((level-1)/2)) do
  local r={w=12,h=16,vx=0,vy=0,face=1,dead=0,drop=0}
  place_robber(r)
  add(robbers,r)
 end
 state="play"
 msg="grab the coins!"
 msgt=60
end

-- back inside the fort
function home()
 pl.x=fort.x+4 pl.y=fort.y+fort.h-pl.h
 pl.vx=0 pl.vy=0 pl.drop=0
end

-->8
-- helpers

function hit(a,b)
 return a.x+2<b.x+b.w and b.x+2<a.x+a.w
  and a.y+2<b.y+b.h and b.y+2<a.y+a.h
end

-- the unicorn is safe when she's
-- standing inside the fort
function safe()
 local cx=pl.x+pl.w/2
 return cx>fort.x+2 and cx<fort.x+fort.w-2
  and pl.y+pl.h>fort.y+6
end

-- gravity + one-way platforms
function phys(e)
 e.vy=min(e.vy+grav,4)
 e.x=mid(0,e.x+e.vx,128-e.w)
 local oldb=e.y+e.h
 e.y+=e.vy
 e.ground=false
 if e.drop>0 then e.drop-=1 return end
 if e.vy>=0 then
  local nb=e.y+e.h
  for p in all(plats) do
   if e.x+e.w>p.x and e.x<p.x+p.w
    and oldb<=p.y and nb>=p.y then
    e.y=p.y-e.h
    e.vy=0
    e.ground=true
    e.plat=p
    return
   end
  end
 end
end

function add_coin()
 for tries=1,30 do
  local p=rnd(plats)
  local c={x=p.x+rnd(max(1,p.w-8)),y=p.y-11,w=8,h=8,ph=rnd()}
  local ok=not hit(c,fort)
  for o in all(coins) do
   if hit(c,o) then ok=false end
  end
  if ok then add(coins,c) return end
 end
end

-- put the robber on the platform
-- farthest from the unicorn
function place_robber(r)
 local best,bd=plats[1],-1
 for p in all(plats) do
  local dd=abs(p.x+p.w/2-pl.x)+abs(p.y-pl.y)+rnd(20)
  if dd>bd then bd=dd best=p end
 end
 r.x=mid(0,best.x+best.w/2-6,116)
 r.y=best.y-r.h
 r.vx=0 r.vy=0 r.dead=0 r.drop=0
end

function robber_spd()
 return min(1.2,0.4+level*0.1)
end

-->8
-- update

function _update()
 if msgt and msgt>0 then msgt-=1 end
 for c in all(clouds) do
  c.x+=c.s
  if c.x>140 then c.x=-16 end
 end
 if state=="play" then
  update_player()
  for r in all(robbers) do update_robber(r) end
  update_stars()
  update_coins()
  if #coins==0 then
   state="win"
   sfx(2)
  end
 elseif btnp(4) or btnp(5) then
  if state=="title" or state=="over" then new_game()
  elseif state=="win" then level+=1 start_level() end
 end
end

function update_player()
 local p=pl
 if p.hurt>0 then p.hurt-=1 end
 if p.cool>0 then p.cool-=1 end
 p.vx=0
 if btn(0) then p.vx=-1.2 p.face=-1 end
 if btn(1) then p.vx=1.2 p.face=1 end
 local jump=btn(4) or btn(2)
 if (btnp(4) or btnp(2)) and p.ground then
  p.vy=-3.6
  sfx(0)
 end
 if p.vy<0 and not jump then p.vy+=0.3 end
 if btnp(3) and p.ground and p.plat.y<115 then p.drop=6 end
 if btnp(5) and p.cool<=0 and #stars<3 then
  add(stars,{x=p.x+6+p.face*6,y=p.y+4,w=5,h=5,
   vx=2.5*p.face+p.vx*0.5,vy=-1.8})
  p.cool=15
  sfx(1)
 end
 phys(p)
 if p.y>128 then hurt() end
end

function update_robber(r)
 if r.dead>0 then
  r.dead-=1
  r.vy+=0.2
  r.y+=r.vy
  if r.dead==0 then place_robber(r) end
  return
 end
 local hide=safe()
 if r.ground then
  if hide then
   -- can't get in the fort, so he
   -- wanders off grumbling
   r.vx=sgn(r.x-fort.x)*robber_spd()*0.6
  else
   local dx=pl.x-r.x
   if abs(dx)>2 then r.vx=sgn(dx)*robber_spd() else r.vx=0 end
   local pb,rb=pl.y+pl.h,r.y+r.h
   if pb<rb-10 and rnd()<0.03 then r.vy=-3.6 end
   if pb>rb+10 and r.plat.y<115 and rnd()<0.02 then r.drop=6 end
  end
 end
 if r.vx!=0 then r.face=sgn(r.vx) end
 phys(r)
 if r.y>128 then place_robber(r) end
 if not hide and pl.hurt<=0 and hit(r,pl) then hurt() end
end

function update_stars()
 for i=#stars,1,-1 do
  local s=stars[i]
  local oldb=s.y+s.h
  s.x+=s.vx
  s.vy+=0.15
  s.y+=s.vy
  local gone=s.x<-5 or s.x>128 or s.y>128
  if s.vy>0 then
   for p in all(plats) do
    if s.x+s.w>p.x and s.x<p.x+p.w
     and oldb<=p.y and s.y+s.h>=p.y then gone=true end
   end
  end
  for r in all(robbers) do
   if r.dead==0 and hit(s,r) then
    r.dead=60
    r.vy=-2.5
    score+=100
    gone=true
    sfx(3)
   end
  end
  if gone then deli(stars,i) end
 end
end

function update_coins()
 for i=#coins,1,-1 do
  if hit(coins[i],pl) then
   deli(coins,i)
   score+=10
   sfx(5)
  end
 end
end

function hurt()
 lives-=1
 sfx(4)
 stars={}
 if lives<=0 then
  state="over"
  return
 end
 home()
 pl.hurt=60
 for r in all(robbers) do place_robber(r) end
 msg="the robber got you!"
 msgt=45
end

-->8
-- draw

function _draw()
 cls(12)
 for c in all(clouds) do
  circfill(c.x,c.y,5,7)
  circfill(c.x+6,c.y-2,6,7)
  circfill(c.x+12,c.y,5,7)
 end
 if state=="title" then draw_title() return end
 for p in all(plats) do draw_plat(p) end
 sspr(64,0,24,17,fort.x,fort.y)
 for c in all(coins) do
  -- spinning coin: squash the width
  local w=max(1,flr(abs(cos(t()+c.ph))*8+0.5))
  sspr(32,0,8,8,c.x+4-w/2,c.y,w,8)
 end
 for s in all(stars) do sspr(40,0,5,5,s.x,s.y) end
 for r in all(robbers) do
  sspr(16,0,12,16,r.x,r.y,12,16,r.face<0,r.dead>0)
 end
 if pl.hurt==0 or pl.hurt%4<2 then
  sspr(0,0,16,16,pl.x,pl.y,16,16,pl.face<0)
 end
 if state=="play" and safe() then
  print("safe!",fort.x+3,fort.y-14,7)
 end
 draw_hud()
 if msgt>0 then center_text(msg,60,7) end
 if state=="over" then box("game over","score "..score.."  z: again") end
 if state=="win" then box("level clear!","z: next level") end
end

-- tile the rainbow block across
-- the platform's width
function draw_plat(p)
 local x=p.x
 while x<p.x+p.w do
  local w=min(8,p.x+p.w-x)
  sspr(48,0,w,6,x,p.y)
  x+=8
 end
end

function draw_hud()
 rectfill(0,0,127,7,1)
 print("score "..score,1,1,7)
 print("lv"..level,50,1,6)
 sspr(32,0,8,8,66,0)
 print(#coins,76,1,10)
 for i=1,lives do
  sspr(0,0,16,16,124-i*8,0,8,8)
 end
end

function center_text(s,y,c)
 print(s,64-#s*2,y,c)
end

function box(a,b)
 rectfill(14,50,113,76,1)
 rect(14,50,113,76,7)
 center_text(a,56,7)
 center_text(b,66,6)
end

function draw_title()
 -- big rainbow across the sky
 local cols={8,9,10,11,12,2}
 for i=1,6 do
  circ(64,74,52-i*3,cols[i])
  circ(64,74,51-i*3,cols[i])
 end
 rectfill(0,75,127,127,12)
 center_text("rainbow unicorn",14,7)
 sspr(0,0,16,16,24,44,32,32,false)
 sspr(32,0,8,8,60,56,12,12)
 sspr(16,0,12,16,82,44,24,32,true)
 for i=0,15 do sspr(48,0,8,6,i*8,78) end
 center_text("grab all the coins!",88,7)
 center_text("hide in the fort from",96,7)
 center_text("the robber",104,7)
 center_text("arrows move  z jump  x star",114,1)
 center_text("press z to start",121,1)
end
