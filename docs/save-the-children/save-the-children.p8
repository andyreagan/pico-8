pico-8 cartridge // http://www.pico-8.com
version 42
__lua__
-- player properties
player = {
    x = 64,
    y = 64,
    dx = 0,
    dy = 0,
    speed = 0.5,
    jump_power = -4,
    is_grounded = false
}

-- physics constants
gravity = 0.3
friction = 0.85
max_fall_speed = 4

function _init()
    -- initialize game state
end

function _update()
    update_player()
    update_camera()
end

function _draw()
    cls()
    -- draw the map
    camera(camera_x, camera_y)
    map(0, 0, 0, 0, 128, 64)
    
    -- draw the player
    spr(1, player.x, player.y)
end

function update_player()
    -- horizontal movement
    if btn(0) then -- left
        player.dx -= player.speed
    end
    if btn(1) then -- right
        player.dx += player.speed
    end
    
    -- apply friction
    player.dx *= friction
    
    -- jumping
    if btn(4) and player.is_grounded then
        player.dy = player.jump_power
        player.is_grounded = false
    end
    
    -- apply gravity
    player.dy += gravity
    
    -- limit fall speed
    if player.dy > max_fall_speed then
        player.dy = max_fall_speed
    end
    
    -- check collisions and move
    move_player()
end

function move_player()
    -- horizontal movement and collision
    local new_x = player.x + player.dx
    if not check_collision(new_x, player.y) then
        player.x = new_x
    else
        player.dx = 0
    end
    
    -- vertical movement and collision
    local new_y = player.y + player.dy
    if not check_collision(player.x, new_y) then
        player.y = new_y
        player.is_grounded = false
    else
        -- if moving down, we've hit ground
        if player.dy > 0 then
            player.is_grounded = true
        end
        player.dy = 0
    end
end

function check_collision(x, y)
    -- check the four corners of the player sprite
    local points = {
        {x = x,     y = y},     -- top-left
        {x = x + 7, y = y},     -- top-right
        {x = x,     y = y + 7}, -- bottom-left
        {x = x + 7, y = y + 7}  -- bottom-right
    }
    
    for point in all(points) do
        -- convert pixel position to tile position
        local tile_x = flr(point.x / 8)
        local tile_y = flr(point.y / 8)
        
        -- check if the tile at this position is sprite 2
        if mget(tile_x, tile_y) == 2 then
            return true
        end
    end
    
    return false
end

function update_camera()
    -- camera follows player with some margin
    camera_x = player.x - 64
    camera_y = player.y - 64
    
    -- keep camera within map bounds
    camera_x = mid(0, camera_x, 1024 - 128)
    camera_y = mid(0, camera_y, 512 - 128)
end
