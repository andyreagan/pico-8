pico-8 cartridge // http://www.pico-8.com
version 42
__lua__
-- dave digger bot
-- a dig-dug style game
-- dave digs, grabs gems, and
-- throws chickens at the bots!

function _init()
 t=8        -- tile size
 cols=16
 toppx=16   -- hud height in px
 rows=14    -- play rows
 new_game()
end

function new_game()
 score=0
 lives=3
 level=1
 start_level()
end

function start_level()
 music(0)
 dug={}
 for c=0,cols-1 do
  dug[c]={}
  for r=0,rows-1 do dug[c][r]=false end
 end
 dave={x=8*t,y=toppx,dir=0,face=1,aim=1,cool=0,hurt=0}
 -- short entry tunnel from the top
 dug[8][0]=true
 dug[8][1]=true
 diamonds={}
 local n=5+level
 local tries=0
 while #diamonds<n and tries<500 do
  tries+=1
  local c=flr(rnd(cols))
  local r=flr(rnd(rows-2))+2
  local ok=true
  for d in all(diamonds) do
   if d.c==c and d.r==r then ok=false end
  end
  if c==8 and r<=1 then ok=false end
  if ok then add(diamonds,{c=c,r=r}) end
 end
 bots={}
 chickens={}
 spawn_timer=150
 maxbots=2+flr(level/2)
 state="play"
 msg=""
 msgt=0
end

-->8
-- helpers

function centerc(a) return flr((a.x+4)/t) end
function centerr(a) return flr((a.y+4-toppx)/t) end

function dig_at(c,r)
 if c>=0 and c<cols and r>=0 and r<rows then dug[c][r]=true end
end

function is_dug(c,r)
 if c<0 or c>=cols or r<0 or r>=rows then return false end
 return dug[c][r]
end

-->8
-- update

function _update()
 if state=="play" then
  update_dave()
  update_bots()
  update_chickens()
  update_spawn()
  check_win()
 else
  if btnp(4) or btnp(5) then
   if state=="over" then new_game()
   elseif state=="win" then level+=1 start_level() end
  end
 end
 if msgt>0 then msgt-=1 end
end

function update_dave()
 local d=dave
 if d.hurt>0 then d.hurt-=1 end
 if d.cool>0 then d.cool-=1 end
 local ax=d.x%t==0
 local ay=(d.y-toppx)%t==0
 local want=0
 if btn(0) then want=2
 elseif btn(1) then want=1
 elseif btn(2) then want=3
 elseif btn(3) then want=4 end
 if want!=0 then d.aim=want end
 -- only turn or stop on grid points, so dave always finishes a
 -- cell and never gets stuck mid-tunnel between alignment frames
 if ax and ay then d.dir=want end
 if d.dir!=0 then
  if d.dir==1 then d.x+=1 d.face=1
  elseif d.dir==2 then d.x-=1 d.face=-1
  elseif d.dir==3 then d.y-=1
  elseif d.dir==4 then d.y+=1 end
  d.x=mid(0,d.x,(cols-1)*t)
  d.y=mid(toppx,d.y,toppx+(rows-1)*t)
 end
 -- dig where dave stands
 dig_at(centerc(d),centerr(d))
 -- grab diamonds
 local c,r=centerc(d),centerr(d)
 for i=#diamonds,1,-1 do
  local dm=diamonds[i]
  if dm.c==c and dm.r==r then
   deli(diamonds,i)
   score+=50
   sfx(0)
  end
 end
 -- throw a chicken
 if btnp(4) and d.cool<=0 then
  throw_chicken()
  d.cool=12
 end
end

function throw_chicken()
 local d=dave
 local vx,vy=0,0
 local a=d.aim
 if a==1 then vx=3
 elseif a==2 then vx=-3
 elseif a==3 then vy=-3
 elseif a==4 then vy=3
 else vx=3*d.face end
 add(chickens,{x=d.x+4,y=d.y+4,vx=vx,vy=vy})
 sfx(0)
end

function update_chickens()
 for i=#chickens,1,-1 do
  local ch=chickens[i]
  ch.x+=ch.vx
  ch.y+=ch.vy
  local dead=false
  if ch.x<0 or ch.x>127 or ch.y<toppx or ch.y>127 then dead=true end
  local c=flr(ch.x/t)
  local r=flr((ch.y-toppx)/t)
  if not is_dug(c,r) then dead=true end
  for b in all(bots) do
   if b.alive and abs(b.x+4-ch.x)<7 and abs(b.y+4-ch.y)<7 then
    b.alive=false
    b.die=18
    dead=true
    score+=100
    sfx(0)
   end
  end
  if dead then deli(chickens,i) end
 end
end

function update_bots()
 for i=#bots,1,-1 do
  local b=bots[i]
  if b then
   if not b.alive then
    b.die-=1
    if b.die<=0 then deli(bots,i) end
   else
    move_bot(b)
    if dave.hurt<=0 and abs(b.x-dave.x)<6 and abs(b.y-dave.y)<6 then
     hit_dave()
     return
    end
   end
  end
 end
end

-- bot speed ramps with level. dave moves 1px/frame, so bots
-- start slower (0.5), match him around lv8, and top out at
-- 2x dave by lv22 -- brutal late game.
function bot_spd()
 return min(2,0.5+(level-1)*0.07)
end

function move_bot(b)
 -- accumulate fractional speed, take 1px steps
 b.acc+=bot_spd()
 while b.acc>=1 do
  b.acc-=1
  step_bot(b)
 end
end

function step_bot(b)
 local ax=b.x%t==0
 local ay=(b.y-toppx)%t==0
 if ax and ay then
  local c=b.x/t
  local r=(b.y-toppx)/t
  local best=nil
  local bestd=32000
  local dirs={{1,1,0},{2,-1,0},{3,0,-1},{4,0,1}}
  for k=1,4 do
   local di=dirs[k]
   local nc=c+di[2]
   local nr=r+di[3]
   if is_dug(nc,nr) then
    local rev=(di[1]==1 and b.dir==2) or (di[1]==2 and b.dir==1)
     or (di[1]==3 and b.dir==4) or (di[1]==4 and b.dir==3)
    local dd=abs(nc*t-dave.x)+abs(toppx+nr*t-dave.y)
    if rev then dd+=40 end
    if dd<bestd then bestd=dd best=di[1] end
   end
  end
  b.dir=best or 0
 end
 if b.dir==1 then b.x+=1
 elseif b.dir==2 then b.x-=1
 elseif b.dir==3 then b.y-=1
 elseif b.dir==4 then b.y+=1 end
end

function hit_dave()
 lives-=1
 dave.hurt=60
 sfx(0)
 if lives<=0 then
  state="over"
  music(-1)
 else
  dave.x=8*t dave.y=toppx dave.dir=0
  bots={}
  chickens={}
  spawn_timer=120
  msg="ouch!" msgt=50
 end
end

function update_spawn()
 if #bots>=maxbots then return end
 spawn_timer-=1
 if spawn_timer<=0 then
  spawn_timer=90+flr(rnd(60))
  spawn_bot()
 end
end

function spawn_bot()
 for tries=1,40 do
  local c=flr(rnd(cols))
  local r=flr(rnd(rows))
  if is_dug(c,r) then
   local x=c*t local y=toppx+r*t
   if abs(x-dave.x)+abs(y-dave.y)>40 then
    add(bots,{x=x,y=y,dir=0,alive=true,acc=0,die=0})
    return
   end
  end
 end
end

function check_win()
 if #diamonds==0 then
  state="win"
  music(-1)
 end
end

-->8
-- draw

function _draw()
 cls(0)
 draw_field()
 draw_diamonds()
 draw_chickens()
 draw_bots()
 draw_dave()
 draw_hud()
 if state=="over" then center_msg("game over","press z") end
 if state=="win" then center_msg("level clear!","press z") end
 if msgt>0 then
  print(msg,dave.x-2,dave.y-8,8)
 end
end

function draw_field()
 for c=0,cols-1 do
  for r=0,rows-1 do
   local x=c*t local y=toppx+r*t
   if not dug[c][r] then
    rectfill(x,y,x+7,y+7,4)
    local s=(c*7+r*13)%4
    pset(x+1+s,y+2,2)
    pset(x+5-s,y+5,2)
    if (c+r)%2==0 then pset(x+3,y+6,9) end
   end
  end
 end
 rectfill(0,toppx-1,127,toppx-1,3)
end

function draw_diamonds()
 for d in all(diamonds) do
  local cx=d.c*t+4
  local cy=toppx+d.r*t+4
  for dy=-3,3 do
   local w=3-abs(dy)
   line(cx-w,cy+dy,cx+w,cy+dy,12)
  end
  pset(cx-1,cy-1,7)
  pset(cx,cy,7)
 end
end

function draw_chickens()
 for ch in all(chickens) do
  sspr(32,0,16,16, ch.x-4,ch.y-4, 8,8, ch.vx<0)
 end
end

function draw_bots()
 for b in all(bots) do
  if b.alive then
   sspr(70,11,18,18, b.x-4,b.y-6, 16,16)
  else
   circ(b.x+4,b.y+4, min(7,2+(18-b.die)), 7)
   circ(b.x+4,b.y+4, min(5,18-b.die), 9)
  end
 end
end

function draw_dave()
 local d=dave
 if d.hurt>0 and d.hurt%4<2 then return end
 sspr(4,1,16,28, d.x-4,d.y-9, 16,16, d.face==-1)
end

function draw_hud()
 rectfill(0,0,127,toppx-2,1)
 print("score "..score,2,2,7)
 print("lvl "..level,2,9,6)
 print("gems "..#diamonds,52,2,12)
 for i=1,lives do
  sspr(4,1,16,28, 86+i*9, 2, 8,10)
 end
 print("z:throw",84,10,9)
end

function center_msg(a,b)
 rectfill(28,50,99,74,0)
 rect(28,50,99,74,7)
 print(a,64-#a*2,57,7)
 print(b,64-#b*2,65,6)
end

