pico-8 cartridge // http://www.pico-8.com
version 42
__lua__
function _init()
  guy=1
  i=0
  x=0
  y=0
end

function _update()
  if guy==1 and i==2 then
    guy=2
    i=0
  else
    i+=1
  end
  if guy==2 and i==2 then
    guy=1
    i=0
  else
    i+=1
  end
  if btn(⬆️) then
    y+=1
  end
  if btn(⬇️) then
    y-=1
  end
  if btn(➡️) then
    x+=1
  end
  if btn(⬅️) then
    x-=1
  end
end

function _draw()
  cls()
  spr(guy, 16+x, 16-y)
end  

