pico-8 cartridge // http://www.pico-8.com
version 42
__lua__
function _init()
	x_position=63
	y_position=56
	baddie_pos_x=100
	baddie_pos_y=64
	baddie=false
	baddie_direction=1
	health=6
	x_map=0
	y_map=0
	running=0
	cat=4
	music(0)
	fx=false
	won=false
	lose=false
end

function _update()
	local map_moving=0
	if btn(➡️) then
	 fx=false
	 if x_position > 80 then
	  x_map+=1/4
	 else
			x_position+=1
		end
	 if running==1 then
	  cat=4
	  running=0
	 else
	  cat=20
	  running=1
	 end
	end
	if btn(⬅️) then
	 fx=true
	 if x_position < 40 then 
	  x_map-=1/4
	 else
	 	x_position-=1
	 end
	 if running==1 then
	  cat=4
	  running=0
	 else
	  cat=20
	  running=1
	 end
	end
	if btn(⬆️) then
	 if y_position < 16 then
	  y_map-=1
	  y_position+=8
	 else
	  y_position-=1
	 end
	end
	if btn(⬇️) then
	 if y_position > (8*14) then
	  y_map+=1
	  y_position-=8
	 else
	  y_position+=1
	 end
	end
	if x_map > 19 then
	 baddie=true
	end
	if abs(x_position - baddie_pos_x) < 6 then
		if (y_position < baddie_pos_y) and abs(y_position-baddie_pos_y) < 8 then
		 won=true
		 baddie=false
		end
	end
	if abs(x_position - baddie_pos_x) < 6 then
		if (y_position > baddie_pos_y) and abs(y_position-baddie_pos_y) < 8 then
		 lost=true
		 baddie=false
		end
	end
	if baddie then
	 if baddie_pos_x > 100 then
	  baddie_direction=-1
	 end
	 if baddie_pos_x < 10 then
	  baddie_direction=1
	 end
	 baddie_pos_x+=baddie_direction
	end
end

function _draw()
	cls()
	map(x_map,y_map)
	print("health:")
	print(health)
	if not lost then
	 spr(cat,x_position,y_position,1,1,fx)
	end
	if baddie then
	 spr(8,baddie_pos_x,baddie_pos_y,1,1)
	end
	if won then
	 -- print("you win. we will make the game harder", 64, 30)
	end
	if lost then
	 -- print("you lose")
	end
end
