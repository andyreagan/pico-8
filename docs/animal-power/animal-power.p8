pico-8 cartridge // http://www.pico-8.com
version 42
__lua__
function _init()
 music(0)
 cheetah_x=64
 cheetah_y=64
 gravity=1
 map_x=0
 map_y=0
 max_jump=100
 win=false
 character=1
 speed=1
end

function _update()
 if character == 1 then
  speed=3
 end
 if character == 2 then
  speed=1
 end
 local cheetah_x_start=cheetah_x
 local cheetah_y_start=cheetah_y
 if btn(➡️) then
  if cheetah_x > 80 then
   cheetah_x-=8-speed
   map_x+=1
  else
   cheetah_x+=speed
  end
 end
 if btn(⬅️) then
  if cheetah_x < 10 then
   cheetah_x+=8-speed
   map_x-=speed
  else
   cheetah_x-=speed
  end
 end
 if btn(⬆️) then
  if cheetah_y > 64 then
   cheetah_y-=2
  -- else
  -- cheetah_y+=8
  -- map_y-=1
  end
 end
 if btn(⬇️) then
  cheetah_y+=0
 end
 -- gravity if no block below --
 if mget(
  map_x+cheetah_x/8,
  map_y+(cheetah_y+8)/8
  ) == 0 then
  cheetah_y+=gravity
 end
 -- look block to right --
 if mget(
  map_x+cheetah_x/8+1,
  map_y+cheetah_y/8+4/8
  ) == 3 then
  cheetah_x=cheetah_x_start
 end
 -- ceiling --
 if mget(
  map_x+cheetah_x/8+4/8,
  map_y+cheetah_y/8-1/8
  ) == 9 then
  cheetah_y=cheetah_y_start
 end
 -- move map down --
 if cheetah_y > 13*8 then
  map_y+=1
  cheetah_y-=8
 end
 -- winning --
 if mget(
  map_x+cheetah_x/8,
  map_y+(cheetah_y+8)/8
  ) == 10 then
  win=true
 end
 -- switch character --
 if mget(
  map_x+cheetah_x/8,
  map_y+(cheetah_y+8)/8
  ) == 2 then
  character=2
 end 
end

function _draw()
 cls()
 map(map_x,map_y)
 if win then
  print("you win", 60, 60)
  music(2)
 else
  spr(character,cheetah_x,cheetah_y)
 end
end
