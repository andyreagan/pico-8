pico-8 cartridge // http://www.pico-8.com
version 42
__lua__
-- night owl
-- pick a penguin, snail, unicorn
-- or dragon. catch the fireflies
-- on the moon blocks, shoot the
-- owl, and hide in your safe
-- house when he gets close!

function _init()
 grav=0.25
 -- sx,sy,sw,sh: the drawing
 chars={
  {name="penguin",sx=64,sy=32,sw=9,sh=11,w=8,h=10,spd=1.1,
   shot="ice",home="igloo",info="shoots ice: freezes the owl"},
  {name="snail",sx=32,sy=32,sw=12,sh=8,w=10,h=7,spd=0.9,
   shot="shell",home="mushroom",info="shoots shells: they roll"},
  {name="unicorn",sx=16,sy=32,sw=16,sh=16,w=14,h=15,spd=1.2,
   shot="star",home="rainbow",info="shoots stars up and over"},
  {name="dragon",sx=0,sy=32,sw=16,sh=12,w=14,h=11,spd=1.2,
   shot="fire",home="cave",info="shoots fire, straight + fast"},
 }
 sel=1
 layouts={
  {{0,120,128},{30,98,36},{82,98,40},{36,76,56},
   {0,54,36},{92,54,36},{40,32,48}},
  {{0,120,128},{34,100,26},{70,98,26},{104,100,24},
   {20,78,36},{72,78,36},{0,56,28},{50,56,28},
   {100,56,28},{30,34,68}},
  {{0,120,50},{78,120,50},{30,98,24},{74,98,24},
   {0,78,40},{88,78,40},{44,60,40},{8,40,32},
   {88,40,32},{44,22,40}},
 }
 fort={x=1,y=103,w=24,h=17}
 -- the night sky
 sky={}
 for i=1,40 do
  add(sky,{x=rnd(128),y=8+rnd(108),p=rnd(),c=rnd({7,7,6,10,12})})
 end
 moons={}
 for i=1,3 do
  add(moons,{x=rnd(128),y=14+i*22+rnd(8),s=0.03+rnd(0.05)})
 end
 parts={}
 state="title"
end

function new_game()
 score=0
 lives=3
 level=1
 ch=chars[sel]
 start_level()
end

function start_level()
 plats={}
 for l in all(layouts[(level-1)%#layouts+1]) do
  add(plats,{x=l[1],y=l[2],w=l[3]})
 end
 pl={w=ch.w,h=ch.h,face=1,cool=0,hurt=0}
 home()
 shots={}
 flies={}
 for i=1,4+level*2 do add_fly() end
 owls={}
 for i=1,min(3,1+flr((level-1)/2)) do
  local o={w=12,h=12,dead=0,ice=0,vy=0,ph=rnd()}
  place_owl(o)
  add(owls,o)
 end
 state="play"
 msg="catch the fireflies!"
 msgt=60
end

-- back inside the safe house
function home()
 pl.x=fort.x+12-pl.w/2 pl.y=fort.y+fort.h-pl.h
 pl.vx=0 pl.vy=0 pl.drop=0
end

-->8
-- helpers

function hit(a,b)
 return a.x+2<b.x+b.w and b.x+2<a.x+a.w
  and a.y+2<b.y+b.h and b.y+2<a.y+a.h
end

-- you are safe standing inside
-- your house. the owl has no
-- safe place at all!
function safe()
 local cx=pl.x+pl.w/2
 return cx>fort.x+2 and cx<fort.x+fort.w-2
  and pl.y+pl.h>fort.y+6
end

-- gravity + one-way platforms
function phys(e)
 e.vy=min(e.vy+grav,4)
 e.x=mid(0,e.x+e.vx,128-e.w)
 local oldb=e.y+e.h
 e.y+=e.vy
 e.ground=false
 if e.drop>0 then e.drop-=1 return end
 if e.vy>=0 then
  local nb=e.y+e.h
  for p in all(plats) do
   if e.x+e.w>p.x and e.x<p.x+p.w
    and oldb<=p.y and nb>=p.y then
    e.y=p.y-e.h
    e.vy=0
    e.ground=true
    e.plat=p
    return
   end
  end
 end
end

function add_fly()
 for tries=1,30 do
  local p=rnd(plats)
  local c={x=p.x+rnd(max(1,p.w-8)),y=p.y-12,w=8,h=8,ph=rnd()}
  local ok=not hit(c,fort)
  for o in all(flies) do
   if hit(c,o) then ok=false end
  end
  if ok then add(flies,c) return end
 end
end

-- the owl starts in the sky far
-- from you
function place_owl(o)
 o.x=70+rnd(46)
 o.y=10+rnd(20)
 o.dead=0 o.ice=0 o.vy=0
end

function owl_spd()
 return min(0.8,0.2+level*0.05)
end

function poof(x,y,cols,n)
 for i=1,n do
  local a=rnd()
  add(parts,{x=x,y=y,vx=cos(a)*(0.4+rnd()),vy=sin(a)*(0.4+rnd()),
   c=rnd(cols),t=8+rnd(12)})
 end
end

-->8
-- update

function _update()
 if msgt and msgt>0 then msgt-=1 end
 for m in all(moons) do
  m.x+=m.s
  if m.x>136 then m.x=-8 end
 end
 for i=#parts,1,-1 do
  local p=parts[i]
  p.x+=p.vx p.y+=p.vy p.t-=1
  if p.t<=0 then deli(parts,i) end
 end
 if state=="play" then
  update_player()
  for o in all(owls) do
   if state=="play" then update_owl(o) end
  end
  update_shots()
  update_flies()
  if state=="play" and #flies==0 then
   state="win"
   sfx(2)
  end
 elseif state=="title" then
  if btnp(0) then sel=(sel-2)%#chars+1 sfx(5) end
  if btnp(1) then sel=sel%#chars+1 sfx(5) end
  if btnp(4) or btnp(5) then new_game() end
 elseif btnp(4) or btnp(5) then
  if state=="over" then state="title"
  elseif state=="win" then level+=1 start_level() end
 end
end

function update_player()
 local p=pl
 if p.hurt>0 then p.hurt-=1 end
 if p.cool>0 then p.cool-=1 end
 p.vx=0
 if btn(0) then p.vx=-ch.spd p.face=-1 end
 if btn(1) then p.vx=ch.spd p.face=1 end
 local jump=btn(4) or btn(2)
 if (btnp(4) or btnp(2)) and p.ground then
  p.vy=-3.6
  sfx(0)
 end
 if p.vy<0 and not jump then p.vy+=0.3 end
 if btnp(3) and p.ground and p.plat.y<115 then p.drop=6 end
 if btnp(5) and p.cool<=0 and #shots<3 then
  shoot(p)
  p.cool=15
  sfx(1)
 end
 phys(p)
 if p.y>128 then hurt() end
end

function shoot(p)
 local k=ch.shot
 local s={k=k,x=p.x+p.w/2-3+p.face*6,y=p.y+p.h/2-4,w=6,h=6,
  vx=2.5*p.face,vy=0,g=0,t=40,drop=0}
 if k=="star" then
  -- up and over
  s.vy=-1.8 s.g=0.15 s.t=200
 elseif k=="fire" then
  s.vx=3.2*p.face s.t=26
 elseif k=="shell" then
  -- rolls along the blocks
  s.w=8 s.h=7 s.vx=2*p.face s.vy=-1 s.g=0.2 s.t=110
 end
 add(shots,s)
end

function update_owl(o)
 if o.dead>0 then
  -- knocked out of the sky
  o.dead-=1
  o.vy+=0.2
  o.y+=o.vy
  if o.dead==0 then place_owl(o) end
  return
 end
 if o.ice>0 then
  -- frozen in a block of ice
  o.ice-=1
  if o.ice==0 then poof(o.x+6,o.y+6,{12,7},8) end
  return
 end
 local tx,ty=pl.x+pl.w/2-6,pl.y+pl.h/2-6
 local sp=owl_spd()
 if safe() then
  -- can't get in, so he flies off
  tx=100 ty=14
 end
 local dx,dy=tx-o.x,ty-o.y
 local d=sqrt(dx*dx+dy*dy)
 if d>1 then
  o.x+=dx/d*sp
  o.y+=dy/d*sp
 end
 if dx!=0 then o.face=sgn(dx) end
 if not safe() and pl.hurt<=0 and hit(o,pl) then hurt() end
end

function update_shots()
 for i=#shots,1,-1 do
  local s=shots[i]
  s.t-=1
  local gone=s.t<=0
  if s.k=="shell" then
   s.vy=min(s.vy+s.g,4)
   local ox=s.x
   s.x+=s.vx
   local oldb=s.y+s.h
   s.y+=s.vy
   for p in all(plats) do
    if s.vy>=0 and s.x+s.w>p.x and s.x<p.x+p.w
     and oldb<=p.y and s.y+s.h>=p.y then
     s.y=p.y-s.h s.vy=0
    end
   end
   -- bounce off the sides
   if s.x<0 or s.x>120 then s.vx=-s.vx s.x=ox end
   if s.y>128 then gone=true end
  else
   s.x+=s.vx
   s.vy+=s.g
   local oldb=s.y+s.h
   s.y+=s.vy
   if s.x<-6 or s.x>128 or s.y>128 then gone=true end
   if s.k=="star" and s.vy>0 then
    for p in all(plats) do
     if s.x+s.w>p.x and s.x<p.x+p.w
      and oldb<=p.y and s.y+s.h>=p.y then gone=true end
    end
   end
   if s.k=="fire" then
    add(parts,{x=s.x+3,y=s.y+3,vx=0,vy=rnd(0.6)-0.3,c=rnd({8,9,10}),t=6})
   end
  end
  for o in all(owls) do
   if not gone and o.dead==0 and o.ice==0 and hit(s,o) then
    if s.k=="ice" then
     o.ice=120
    else
     o.dead=60
     o.vy=-2.5
    end
    poof(o.x+6,o.y+6,s.k=="ice" and {12,7} or {4,9,10},10)
    score+=100
    gone=true
    sfx(3)
   end
  end
  if gone then deli(shots,i) end
 end
end

function update_flies()
 for i=#flies,1,-1 do
  local f=flies[i]
  if hit(f,pl) then
   poof(f.x+4,f.y+4,{10,11,7},6)
   deli(flies,i)
   score+=10
   sfx(5)
  end
 end
end

function hurt()
 lives-=1
 sfx(4)
 shots={}
 poof(pl.x+pl.w/2,pl.y+pl.h/2,{8,7,10},10)
 if lives<=0 then
  state="over"
  return
 end
 home()
 pl.hurt=90
 for o in all(owls) do place_owl(o) end
 msg="the owl got you!"
 msgt=45
end

-->8
-- draw

function draw_sky()
 cls(0)
 for s in all(sky) do
  if (t()*0.5+s.p)%1<0.85 then pset(s.x,s.y,s.c) end
 end
 -- one big moon and little ones
 circfill(104,22,9,10)
 circfill(101,19,2,9)
 circfill(108,25,1,9)
 circfill(105,17,1,9)
 if state=="title" then return end
 for m in all(moons) do
  circfill(m.x,m.y,4,10)
  circfill(m.x+2,m.y-1,3,0)
 end
end

function draw_char(c,x,y,fl)
 sspr(c.sx,c.sy,c.sw,c.sh,x,y,c.sw,c.sh,fl)
end

-- every animal has its own safe
-- house. x,y is the top left of
-- a 24x17 box
function draw_home(k,x,y)
 clip(x-1,y-1,27,18)
 if k=="igloo" then
  circfill(x+12,y+16,12,7)
  for i=0,2 do line(x+2+i*2,y+8+i*4,x+22-i*2,y+8+i*4,12) end
  line(x+12,y+4,x+12,y+8,12)
  line(x+7,y+8,x+7,y+12,12)
  line(x+17,y+8,x+17,y+12,12)
  rectfill(x+8,y+10,x+16,y+16,1)
  circfill(x+12,y+10,4,1)
 elseif k=="mushroom" then
  rectfill(x+6,y+9,x+18,y+16,15)
  rectfill(x+10,y+11,x+14,y+16,4)
  ovalfill(x,y,x+24,y+11,8)
  circfill(x+6,y+5,2,7)
  circfill(x+13,y+3,2,7)
  circfill(x+19,y+6,2,7)
 elseif k=="rainbow" then
  local cols={8,9,10,11,12,13}
  for i=1,6 do
   circ(x+12,y+16,13-i,cols[i])
   circ(x+12,y+17,13-i,cols[i])
  end
  circfill(x+2,y+15,3,7)
  circfill(x+22,y+15,3,7)
 else
  -- cave
  circfill(x+12,y+16,12,5)
  circfill(x+6,y+12,5,13)
  circfill(x+18,y+9,4,13)
  rectfill(x+7,y+9,x+17,y+16,1)
  circfill(x+12,y+9,5,1)
  pset(x+10,y+15,9)
  pset(x+14,y+14,8)
 end
 clip()
end

-- tile the moon block across the
-- platform. the bottom ones are
-- dark green grass
function draw_plat(p)
 if p.y>=120 then
  rectfill(p.x,p.y,p.x+p.w-1,127,3)
  for x=p.x,p.x+p.w-1,3 do
   pset(x,p.y-1,3)
   if x%2==0 then pset(x+1,p.y+3,1) end
  end
  return
 end
 local x=p.x
 while x<p.x+p.w do
  local w=min(8,p.x+p.w-x)
  sspr(48,0,w,6,x,p.y)
  x+=8
 end
end

function draw_owl(x,y,fl,up,ice)
 if ice then
  for i=1,15 do pal(i,12) end
  pal(10,7) pal(1,1)
 end
 local f=flr(t()*6)%2
 if ice then f=1 end
 sspr(f*16,0,16,14,x-2,y-1,16,14,fl,up)
 pal()
 if ice then
  rect(x-3,y-2,x+14,y+13,7)
 end
end

function draw_shot(s)
 if s.k=="star" then
  sspr(40,0,5,5,s.x,s.y)
 elseif s.k=="fire" then
  circfill(s.x+3,s.y+3,3,8)
  circfill(s.x+3,s.y+3,2,9)
  circfill(s.x+3+rnd(2)-1,s.y+3,1,10)
 elseif s.k=="shell" then
  sspr(52,32,8,7,s.x,s.y,8,7,flr(t()*8)%2==0,flr(t()*4)%2==0)
 else
  -- ice
  sspr(40,8,6,6,s.x,s.y,6,6,s.vx<0)
 end
end

function draw_fly(f)
 local x=f.x+4+sin(t()*0.6+f.ph)*2
 local y=f.y+4+cos(t()*0.9+f.ph)*2
 local on=(t()+f.ph)%1<0.7
 if on then circ(x,y,3,3) circfill(x,y,2,11) end
 pset(x,y,on and 10 or 9)
 pset(x-1,y-1,6)
 pset(x+1,y-1,6)
end

function _draw()
 draw_sky()
 if state=="title" then draw_title() return end
 draw_home(ch.home,fort.x,fort.y)
 for p in all(plats) do draw_plat(p) end
 for f in all(flies) do draw_fly(f) end
 for s in all(shots) do draw_shot(s) end
 for o in all(owls) do
  draw_owl(o.x,o.y,o.face==-1,o.dead>0,o.ice>0)
 end
 if pl.hurt==0 or pl.hurt%4<2 then
  draw_char(ch,pl.x+pl.w/2-ch.sw/2,pl.y+pl.h-ch.sh,pl.face<0)
 end
 for p in all(parts) do pset(p.x,p.y,p.c) end
 if state=="play" and safe() then
  print("safe!",fort.x+3,fort.y-9,7)
 end
 draw_hud()
 if msgt>0 then center_text(msg,60,7) end
 if state=="over" then box("game over","score "..score.."  z: again") end
 if state=="win" then box("level clear!","z: next level") end
end

function draw_hud()
 rectfill(0,0,127,7,1)
 print("score "..score,1,1,7)
 print("lv"..level,50,1,6)
 circfill(69,3,2,11)
 pset(69,3,10)
 print(#flies,76,1,10)
 for i=1,lives do
  print("\135",128-i*8,1,8)
 end
end

function center_text(s,y,c)
 print(s,64-#s*2,y,c)
end

function box(a,b)
 rectfill(14,50,113,76,1)
 rect(14,50,113,76,7)
 center_text(a,56,7)
 center_text(b,66,6)
end

function draw_title()
 center_text("night owl",6,10)
 draw_owl(58,16,false,false,false)
 center_text("< pick your animal >",36,7)
 for i=1,4 do
  local c=chars[i]
  local x=(i-1)*32
  if i==sel then
   rectfill(x+2,44,x+29,84,1)
   rect(x+2,44,x+29,84,10)
  end
  draw_home(c.home,x+4,46)
  draw_char(c,x+16-c.sw/2,82-c.sh)
 end
 local c=chars[sel]
 center_text(c.name,89,10)
 center_text(c.info,96,7)
 center_text("safe in the "..c.home,103,12)
 for i=0,15 do sspr(48,0,8,6,i*8,110) end
 center_text("z jump  x shoot  z: start",118,6)
end
