pico-8 cartridge // http://www.pico-8.com
version 42
__lua__
-- apple guy vs the duck
-- jump the platforms, catch the
-- diamond robots, and throw
-- poison apples at the duck!

function _init()
 grav=0.25
 layouts={
  {{0,120,128},{10,98,40},{78,98,40},{36,76,56},
   {0,54,36},{92,54,36},{40,32,48}},
  {{0,120,128},{0,98,30},{50,100,28},{98,98,30},
   {20,78,36},{72,78,36},{0,56,28},{50,56,28},
   {100,56,28},{30,34,68}},
  {{0,120,50},{78,120,50},{30,98,24},{74,98,24},
   {0,78,40},{88,78,40},{44,60,40},{8,40,32},
   {88,40,32},{44,22,40}},
 }
 state="title"
end

function new_game()
 score=0
 lives=3
 level=1
 start_level()
end

function start_level()
 plats={}
 for l in all(layouts[(level-1)%#layouts+1]) do
  add(plats,{x=l[1],y=l[2],w=l[3]})
 end
 pl={x=4,y=104,w=9,h=16,vx=0,vy=0,face=1,cool=0,hurt=0,drop=0}
 apples={}
 robots={}
 for i=1,3+level do add_robot() end
 ducks={}
 for i=1,min(4,1+flr((level-1)/2)) do
  local d={w=15,h=13,vx=0,vy=0,face=-1,dead=0,drop=0}
  place_duck(d)
  add(ducks,d)
 end
 state="play"
 msg="catch the robots!"
 msgt=60
end

-->8
-- helpers

function hit(a,b)
 return a.x+2<b.x+b.w and b.x+2<a.x+a.w
  and a.y+2<b.y+b.h and b.y+2<a.y+a.h
end

-- gravity + one-way platforms
-- (you can jump up through them
-- and land on top)
function phys(e)
 e.vy=min(e.vy+grav,4)
 e.x=mid(0,e.x+e.vx,128-e.w)
 local oldb=e.y+e.h
 e.y+=e.vy
 e.ground=false
 if e.drop>0 then e.drop-=1 return end
 if e.vy>=0 then
  local nb=e.y+e.h
  for p in all(plats) do
   if e.x+e.w>p.x and e.x<p.x+p.w
    and oldb<=p.y and nb>=p.y then
    e.y=p.y-e.h
    e.vy=0
    e.ground=true
    e.plat=p
    return
   end
  end
 end
end

function add_robot()
 local p=rnd(plats)
 local r={w=10,h=7,ph=rnd()}
 r.plat=p
 r.x=p.x+rnd(max(1,p.w-10))
 r.y=p.y-7
 r.vx=(rnd()<0.5 and -1 or 1)*min(1,0.3+level*0.05)
 add(robots,r)
end

-- put the duck on the platform
-- farthest from the player
function place_duck(d)
 local best,bd=plats[1],-1
 for p in all(plats) do
  local dd=abs(p.x+p.w/2-pl.x)+abs(p.y-pl.y)+rnd(20)
  if dd>bd then bd=dd best=p end
 end
 d.x=best.x+best.w/2-7
 d.y=best.y-d.h
 d.vx=0 d.vy=0 d.dead=0 d.drop=0
end

function duck_spd()
 return min(1.2,0.4+level*0.1)
end

-->8
-- update

function _update()
 if msgt and msgt>0 then msgt-=1 end
 if state=="play" then
  update_player()
  for d in all(ducks) do update_duck(d) end
  update_apples()
  update_robots()
  if #robots==0 then
   state="win"
   sfx(2)
  end
 elseif btnp(4) or btnp(5) then
  if state=="title" or state=="over" then new_game()
  elseif state=="win" then level+=1 start_level() end
 end
end

function update_player()
 local p=pl
 if p.hurt>0 then p.hurt-=1 end
 if p.cool>0 then p.cool-=1 end
 p.vx=0
 if btn(0) then p.vx=-1.2 p.face=-1 end
 if btn(1) then p.vx=1.2 p.face=1 end
 local jump=btn(4) or btn(2)
 if (btnp(4) or btnp(2)) and p.ground then
  p.vy=-3.6
  sfx(0)
 end
 -- let go early for a short hop
 if p.vy<0 and not jump then p.vy+=0.3 end
 -- down drops through a platform
 if btnp(3) and p.ground and p.plat.y<115 then p.drop=6 end
 if btnp(5) and p.cool<=0 and #apples<3 then
  add(apples,{x=p.x+2+p.face*4,y=p.y+5,w=4,h=5,
   vx=2.5*p.face+p.vx*0.5,vy=-1.8})
  p.cool=15
  sfx(1)
 end
 phys(p)
 if p.y>128 then hurt() end
end

function update_duck(d)
 if d.dead>0 then
  -- tumbling off screen
  d.dead-=1
  d.vy+=0.2
  d.y+=d.vy
  if d.dead==0 then place_duck(d) end
  return
 end
 if d.ground then
  local dx=pl.x-d.x-3
  if abs(dx)>2 then d.vx=sgn(dx)*duck_spd() else d.vx=0 end
  local pb,db=pl.y+pl.h,d.y+d.h
  -- player above? hop up sometimes
  if pb<db-10 and rnd()<0.03 then d.vy=-3.6 end
  -- player below? drop down sometimes
  if pb>db+10 and d.plat.y<115 and rnd()<0.02 then d.drop=6 end
 end
 if d.vx!=0 then d.face=sgn(d.vx) end
 phys(d)
 if d.y>128 then place_duck(d) end
 if pl.hurt<=0 and hit(d,pl) then hurt() end
end

function update_apples()
 for i=#apples,1,-1 do
  local a=apples[i]
  local oldb=a.y+a.h
  a.x+=a.vx
  a.vy+=0.15
  a.y+=a.vy
  local gone=a.x<-4 or a.x>128 or a.y>128
  -- splat on platform tops
  if a.vy>0 then
   for p in all(plats) do
    if a.x+a.w>p.x and a.x<p.x+p.w
     and oldb<=p.y and a.y+a.h>=p.y then gone=true end
   end
  end
  for d in all(ducks) do
   if d.dead==0 and hit(a,d) then
    d.dead=60
    d.vy=-2.5
    score+=100
    gone=true
    sfx(3)
   end
  end
  if gone then deli(apples,i) end
 end
end

function update_robots()
 for i=#robots,1,-1 do
  local r=robots[i]
  r.x+=r.vx
  local p=r.plat
  if r.x<p.x or r.x+r.w>p.x+p.w or r.x<0 or r.x+r.w>128 then
   r.vx=-r.vx
   r.x=mid(max(0,p.x),r.x,min(128,p.x+p.w)-r.w)
  end
  if hit(r,pl) then
   deli(robots,i)
   score+=50
   sfx(2)
  end
 end
end

function hurt()
 lives-=1
 sfx(4)
 apples={}
 if lives<=0 then
  state="over"
  return
 end
 pl.x=4 pl.y=104 pl.vx=0 pl.vy=0 pl.drop=0
 pl.hurt=60
 for d in all(ducks) do place_duck(d) end
 msg="quack attack!"
 msgt=45
end

-->8
-- draw

function _draw()
 cls(1)
 if state=="title" then draw_title() return end
 for p in all(plats) do draw_plat(p) end
 for r in all(robots) do
  local bob=sin(t()*2+r.ph)>0 and 1 or 0
  sspr(101,6,10,7,r.x,r.y-bob)
 end
 for a in all(apples) do sspr(52,6,4,5,a.x,a.y) end
 for d in all(ducks) do
  -- sprite faces left, flip when walking right
  sspr(24,1,15,13,d.x,d.y,15,13,d.face>0,d.dead>0)
 end
 if pl.hurt==0 or pl.hurt%4<2 then
  sspr(11,0,9,16,pl.x,pl.y,9,16,pl.face<0)
 end
 draw_hud()
 if msgt>0 then center_text(msg,60,7) end
 if state=="over" then box("game over","score "..score.."  z: again") end
 if state=="win" then box("level clear!","z: next level") end
end

-- tile the platform drawing across
-- the platform's width
function draw_plat(p)
 local x=p.x
 while x<p.x+p.w do
  local w=min(28,p.x+p.w-x)
  sspr(67,11,w,6,x,p.y)
  x+=28
 end
end

function draw_hud()
 rectfill(0,0,127,7,0)
 print("score "..score,1,1,7)
 print("lv"..level,50,1,6)
 sspr(101,6,10,7,66,0)
 print(#robots,78,1,12)
 for i=1,lives do
  sspr(11,0,9,16,124-i*7,0,5,8)
 end
end

function center_text(s,y,c)
 print(s,64-#s*2,y,c)
end

function box(a,b)
 rectfill(14,50,113,76,0)
 rect(14,50,113,76,7)
 center_text(a,56,7)
 center_text(b,66,6)
end

function draw_title()
 center_text("apple guy vs the duck",20,7)
 sspr(11,0,9,16,30,40,18,32)
 sspr(52,6,4,5,54,52,8,10)
 sspr(24,1,15,13,70,44,30,26)
 sspr(101,6,10,7,50,80,20,14)
 center_text("catch the diamond robots!",100,12)
 center_text("arrows move  z jump  x apple",110,6)
 center_text("down: drop   press z to start",118,5)
end
